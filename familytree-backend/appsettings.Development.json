{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "familytree_backend.Services.AnalysisBackgroundService": "Information",
      "familytree_backend.Services.AIService": "Information",
      "familytree_backend.Controllers.AnalysisController": "Information"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "File": {
      "Path": "logs/familytree-analysis-{Date}.log",
      "LogLevel": {
        "Default": "Information",
        "familytree_backend.Services.AnalysisBackgroundService": "Information",
        "familytree_backend.Services.AIService": "Information",
        "familytree_backend.Controllers.AnalysisController": "Information"
      },
      "FileSizeLimitBytes": 10485760,
      "MaxRollingFiles": 10
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=familytree;Username=user;Password="
  },
  "OpenAI": {
    "ApiKey": "your-openai-api-key-here"
  }
} 