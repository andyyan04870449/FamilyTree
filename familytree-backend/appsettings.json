{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "familytree_backend.Services.AnalysisBackgroundService": "Information",
      "familytree_backend.Services.AIService": "Information",
      "familytree_backend.Controllers.AnalysisController": "Information"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "EnableVerboseLogging": false,
    "RetentionDays": 30,
    "MaxLogFileSizeMB": 100,
    "MaxLogFiles": 100,
    "EnableStructuredLogging": true,
    "EnablePerformanceLogging": true,
    "LogDirectory": "logs",
    "LogFileNameFormat": "familytree-{0}-.log"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=familytree;Username=user;Password=;Encoding=UTF8"
  },
  "Database": {
    "MaxPoolSize": 100,
    "MinPoolSize": 5,
    "ConnectionTimeout": 30,
    "CommandTimeout": 60,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3,
    "MaxQueryTimeout": 300,
    "MaxResultSetSize": 10000,
    "EnableQueryCache": true,
    "CacheExpirationMinutes": 30
  },
  "OpenAI": {
    "ApiKey": "sk-your-actual-openai-api-key",
    "Model": "gpt-3.5-turbo",
    "MaxTokens": 2000,
    "Temperature": 0.7,
    "TimeoutSeconds": 60,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3
  },
  "FileUpload": {
    "MaxFileSizeBytes": 52428800,
    "AllowOverwrite": false,
    "MaxConcurrentUploads": 5,
    "UploadTimeoutSeconds": 300,
    "ProcessingTimeoutSeconds": 600,
    "EnableDuplicateCheck": true,
    "EnableAutoCompression": false,
    "AllowedExtensions": [".xls", ".xlsx", ".jpg", ".jpeg", ".png", ".zip", ".7z"],
    "AllowedMimeTypes": [
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "image/jpeg",
      "image/png",
      "application/zip",
      "application/x-7z-compressed"
    ],
    "UploadDirectory": "user_upload",
    "PhotoUploadDirectory": "photos"
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "MinPageSize": 1
  },
  "Search": {
    "DefaultPageSize": 10,
    "MaxResults": 1000,
    "TimeoutSeconds": 30,
    "EnableFuzzySearch": true,
    "MinFuzzyMatchScore": 0.7,
    "MaxSearchKeywords": 10,
    "EnableSearchCache": true,
    "SearchCacheExpirationMinutes": 15,
    "SearchTypes": {
      "Exact": "exact",
      "Fuzzy": "fuzzy",
      "Partial": "partial",
      "Regex": "regex"
    }
  },
  "RelationshipGraph": {
    "DefaultAnalysisDepth": 3,
    "MaxAnalysisDepth": 5,
    "MinAnalysisDepth": 1,
    "MaxGraphNodes": 500,
    "MaxGraphLinks": 1000,
    "MaxConcurrentAnalysis": 2,
    "AnalysisTimeoutMinutes": 10,
    "EnableCaching": true,
    "CacheExpirationMinutes": 60,
    "MinRelationshipStrength": 0.1,
    "MaxFamilyDepth": 3,
    "MaxFriendConnections": 10
  },
  "Excel": {
    "DefaultWorksheetIndex": 0,
    "DataStartRow": 2,
    "MaxProcessingRows": 10000,
    "BatchSize": 100,
    "MaxConcurrentProcessing": 3,
    "ProcessingTimeoutMinutes": 30,
    "EnableDataValidation": true,
    "EnableDuplicateCheck": true,
    "ColumnMappings": {
      "Name": "姓名",
      "Gender": "性別",
      "Birthday": "生日",
      "Mobile": "手機",
      "FamilyRelationships": "家庭關係",
      "ImportantFriends": "重要朋友"
    }
  },
  "Security": {
    "Authentication": {
      "SessionTimeoutMinutes": 30,
      "MaxLoginAttempts": 5,
      "LockoutDurationMinutes": 15,
      "EnableTwoFactorAuth": false,
      "PasswordMinLength": 8,
      "RequireSpecialCharacters": true
    },
    "Authorization": {
      "AdminRole": "Admin",
      "UserRole": "User",
      "GuestRole": "Guest",
      "EnableRoleBasedAccess": true,
      "EnableResourceLevelAccess": false
    },
    "DataProtection": {
      "EnableDataEncryption": false,
      "EnableAuditLogging": true,
      "AuditLogRetentionDays": 90,
      "MaskSensitiveData": true
    }
  },
  "Performance": {
    "Caching": {
      "EnableMemoryCache": true,
      "MemoryCacheSizeMB": 100,
      "EnableDistributedCache": false,
      "CacheExpirationMinutes": 30,
      "EnableCacheCompression": true
    },
    "Concurrency": {
      "MaxConcurrentRequests": 100,
      "MaxConcurrentDatabaseConnections": 20,
      "RequestTimeoutSeconds": 60,
      "EnableRequestThrottling": true,
      "ThrottleLimit": 1000
    }
  },
  "Environment": {
    "Name": "Development",
    "EnableDebugMode": true,
    "EnableDetailedLogging": true,
    "EnablePerformanceMonitoring": true,
    "EnableErrorReporting": true,
    "DefaultTimeZone": "Asia/Taipei"
  },
  "Jwt": {
    "Issuer": "FamilyTreeAPI",
    "Audience": "FamilyTreeClient",
    "AccessTokenExpiration": 15,
    "RefreshTokenExpiration": 10080
  },
  "KeyRotation": {
    "EnableAutoRotation": true,
    "KeyValidityDays": 30,
    "RotationAdvanceDays": 7,
    "OldKeyRetentionDays": 2,
    "MinKeyLength": 64,
    "CheckIntervalMinutes": 60
  },
  "API": {
    "Version": "1.0.0",
    "Title": "FamilyTree API",
    "Description": "家族樹管理系統 API",
    "Contact": {
      "Name": "FamilyTree Team",
      "Email": "support@familytree.com"
    },
    "License": {
      "Name": "MIT",
      "Url": "https://opensource.org/licenses/MIT"
    },
    "ResponseFormat": {
      "IncludeTimestamp": true,
      "IncludeRequestId": true,
      "EnableDetailedErrors": false
    }
  },
  "Monitoring": {
    "EnableHealthChecks": true,
    "EnableMetrics": true,
    "EnableTracing": false,
    "HealthCheckTimeout": 30,
    "MetricsInterval": 60,
    "EnableApplicationInsights": false,
    "ApplicationInsightsKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7173"
    ],
    "Development": {
      "AllowedOrigins": [
        "http://localhost:4200",
        "http://localhost:3000",
        "http://localhost:8080"
      ]
    },
    "Production": {
      "AllowedOrigins": [
        "https://familytree.yourdomain.com",
        "https://app.familytree.yourdomain.com"
      ]
    },
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "X-Requested-With",
      "Accept",
      "Origin"
    ],
    "AllowCredentials": true,
    "PreflightMaxAgeSeconds": 86400
  }
}
