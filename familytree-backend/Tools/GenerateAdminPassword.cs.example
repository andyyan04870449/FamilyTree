using System;
using familytree_backend.Tools;

// 簡單的密碼產生程式
// 執行方式: dotnet run --project Tools/GenerateAdminPassword.cs

var password = "Admin@123";
var hash = PasswordHashGenerator.GenerateHash(password);

Console.WriteLine("===========================================");
Console.WriteLine("管理員密碼雜湊產生工具");
Console.WriteLine("===========================================");
Console.WriteLine($"密碼: {password}");
Console.WriteLine($"雜湊值: {hash}");
Console.WriteLine();
Console.WriteLine("SQL 更新語句:");
Console.WriteLine(PasswordHashGenerator.GenerateAdminPasswordUpdateSql(password));
Console.WriteLine();
Console.WriteLine("請執行上述 SQL 語句來更新管理員密碼");
Console.WriteLine("===========================================");